# Maintainer: rasid17
pkgname=rustmusic
pkgver=0.4.0
pkgrel=1
pkgdesc="Audiophile-grade desktop music player with native DSD, bit-perfect output and network playback"
arch=('x86_64')
url="https://github.com/rasid17/rustmusic-desktop"
license=('GPL-3.0-only')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'alsa-lib'
  'libayatana-appindicator'
  'hicolor-icon-theme'
)
options=('!strip' '!debug')

_rootdir="$(cd "${startdir}/../.." && pwd)"

build() {
  cd "${_rootdir}"
  if [ ! -f "src-tauri/target/release/RustMusic" ]; then
    npx tauri build --no-bundle --config '{"bundle":{"createUpdaterArtifacts":false}}'
  fi
}

package() {
  cd "${_rootdir}"

  install -Dm755 "src-tauri/target/release/RustMusic" "${pkgdir}/usr/bin/RustMusic"
  ln -s "/usr/bin/RustMusic" "${pkgdir}/usr/bin/rustmusic"

  install -Dm644 "src-tauri/icons/32x32.png" "${pkgdir}/usr/share/icons/hicolor/32x32/apps/RustMusic.png"
  install -Dm644 "src-tauri/icons/128x128.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/RustMusic.png"
  install -Dm644 "src-tauri/icons/128x128@2x.png" "${pkgdir}/usr/share/icons/hicolor/256x256@2/apps/RustMusic.png"
  install -Dm644 "src-tauri/icons/icon.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/RustMusic.png"

  install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/RustMusic.desktop" << 'EOF'
[Desktop Entry]
Categories=AudioVideo;Audio;Music;
Comment=Audiophile music player with native DSD, bit-perfect output and network playback
Exec=RustMusic
StartupWMClass=RustMusic
Icon=RustMusic
Name=RustMusic
Terminal=false
Type=Application
EOF
}
